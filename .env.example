# MemeSmartScrape — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ----------------------------------------------------------------------
# Meme Annotation Pipeline (ScrapeGraph-AI) — see docs/MEME_ANNOTATION.md
# ----------------------------------------------------------------------
# LLM provider is swappable: openai | anthropic | google | ollama
ANNOTATION_LLM_PROVIDER=openai
ANNOTATION_LLM_MODEL=gpt-4o-mini
ANNOTATION_LLM_TEMPERATURE=0.0
# Set the key matching your provider:
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# For an OpenAI-compatible endpoint / local gateway:
# ANNOTATION_LLM_BASE_URL=

# IO  — source: file | mongo  (mongo ingests the discovery `urls` collection)
ANNOTATION_SOURCE=file
ANNOTATION_INPUT_PATH=data/meme_urls.sample.json
ANNOTATION_OUTPUT_PATH=data/annotations.jsonl

# MongoDB hub (discovery sink + annotation source/sink) — see src/db
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=memes

# Run control
ANNOTATION_CONCURRENCY=4
ANNOTATION_MAX_RETRIES=3
ANNOTATION_REQUEST_TIMEOUT=120
ANNOTATION_RATE_LIMIT_PER_MIN=0
ANNOTATION_ONLY_CONFIRMED=true
ANNOTATION_HEADLESS=true

# Proxy (used when your IP is banned — by both annotation and the model renderer)
# ANNOTATION_PROXY_URL=http://host:port
# ANNOTATION_PROXY_USERNAME=
# ANNOTATION_PROXY_PASSWORD=

# ----------------------------------------------------------------------
# Meme GNN+ILP Student Model — see docs/STUDENT_MODEL.md
# ----------------------------------------------------------------------
MEME_MODEL_PATH=meme_model.pt
MEME_LABELED_PATH=data/labeled_memes.json
# Optional: require the title to sit above this y-pixel (0/unset = disabled)
# MEME_TITLE_ZONE_MAX_PX=0
# Drift alert when mean(top1-top2) margin falls below this
MEME_STABILITY_THRESHOLD=0.15
