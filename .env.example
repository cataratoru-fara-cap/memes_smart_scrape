# MemeSmartScrape — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ----------------------------------------------------------------------
# Meme Annotation Pipeline (ScrapeGraph-AI) — see docs/MEME_ANNOTATION.md
# ----------------------------------------------------------------------
# LLM provider is swappable: openai | anthropic | google | ollama
ANNOTATION_LLM_PROVIDER=openai
ANNOTATION_LLM_MODEL=gpt-4o-mini
ANNOTATION_LLM_TEMPERATURE=0.0
# Set the key matching your provider:
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# For an OpenAI-compatible endpoint / local gateway:
# ANNOTATION_LLM_BASE_URL=

# Self-hosted Open WebUI / Ollama lab gateway (OpenAI-compatible surface is
# under /ollama/v1 — the /openai/* routes are disabled on this gateway):
#   ANNOTATION_LLM_PROVIDER=openai
#   ANNOTATION_LLM_MODEL=llama3.3:70b        # an id from GET /ollama/v1/models
#   ANNOTATION_LLM_BASE_URL=https://<lab-host>/ollama/v1
#   OPENAI_API_KEY=<your gateway Bearer token>
# Verify connectivity + model name:  python annotate_memes.py --verify
#
# Ollama models generally can't do json-schema/function-calling; set this false
# to rely on prompt-only JSON extraction (normalize() coerces it). Recommended
# for the lab gateway. Keep true only for hosted OpenAI/Anthropic.
ANNOTATION_STRUCTURED_OUTPUT=true

# IO  — source: file | mongo  (mongo ingests the discovery `urls` collection)
ANNOTATION_SOURCE=file
ANNOTATION_INPUT_PATH=data/meme_urls.sample.json
ANNOTATION_OUTPUT_PATH=data/annotations.jsonl

# MongoDB hub (discovery sink + annotation source/sink) — see src/db
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=memes

# Run control
ANNOTATION_CONCURRENCY=4
ANNOTATION_MAX_RETRIES=3
ANNOTATION_REQUEST_TIMEOUT=120
ANNOTATION_RATE_LIMIT_PER_MIN=0
ANNOTATION_ONLY_CONFIRMED=true
ANNOTATION_HEADLESS=true

# Proxy (used when your IP is banned — by both annotation and the model renderer)
# ANNOTATION_PROXY_URL=http://host:port
# ANNOTATION_PROXY_USERNAME=
# ANNOTATION_PROXY_PASSWORD=

# Rotating free-proxy pool (github.com/proxifly/free-proxy-list). When enabled,
# each render/annotation draws a proxy from the pool and rotates past dead ones.
# Free proxies are unreliable — expect many failures; a paid proxy via
# ANNOTATION_PROXY_URL is more dependable. Test with: python -m src.net.proxy_pool
PROXY_POOL_ENABLED=false
# PROXY_POOL_PROTOCOLS=http           # csv: http,https,socks5
# PROXY_POOL_MAX=50                    # cap the number kept
# PROXY_LIST_URL=https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/protocols/http/data.txt
# PROXY_TEST_URL=https://knowyourmeme.com/robots.txt

# ----------------------------------------------------------------------
# Meme GNN+ILP Student Model — see docs/STUDENT_MODEL.md
# ----------------------------------------------------------------------
MEME_MODEL_PATH=meme_model.pt
MEME_LABELED_PATH=data/labeled_memes.json
# Optional: require the title to sit above this y-pixel (0/unset = disabled)
# MEME_TITLE_ZONE_MAX_PX=0
# Drift alert when mean(top1-top2) margin falls below this
MEME_STABILITY_THRESHOLD=0.15
